<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress>
    <notes><![CDATA[
   vertx-mysql-client-5.0.5.jar mistaken for mysql server
   ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.vertx/vertx-mysql-client@.*$</packageUrl>
    <cpe>cpe:/a:mysql:mysql</cpe>
  </suppress>
  <suppress>
    <notes><![CDATA[
   testcontainers-postgresql is being picked up as a very old version of postgres.  The version actually used is defined at ServerProviderPostgreSQL.PGSQL_IMAGE_NAME, and it's only used in integration tests.
   ]]></notes>
    <packageUrl regex="true">^pkg:maven/org.testcontainers/testcontainers-postgresql@.*$</packageUrl>
    <cpe>cpe:/a:postgresql:postgresql</cpe>
  </suppress>
  <suppress>
    <notes><![CDATA[
   Completely false positive, CVE-2026-54285 relates to a JavaScript client.
   ]]></notes>
    <packageUrl regex="true">^pkg:maven/io.opentelemetry/opentelemetry-api@.*$</packageUrl>
    <cpe>cpe:2.3:a:opentelemetry:opentelemetry:1.68.0:*:*:*:*:*:*:*</cpe>
    <cve>CVE-2026-54285</cve>
  </suppress>
  <suppress>
    <notes><![CDATA[
   Completely false positive, CVE-2026-54285 relates to a JavaScript client.
   ]]></notes>
    <packageUrl regex="true">^pkg:maven/io.opentelemetry/opentelemetry-api-incubator@.*$</packageUrl>
    <cpe>cpe:2.3:a:opentelemetry:opentelemetry:1.68.0:alpha:*:*:*:*:*:*</cpe>
    <cve>CVE-2026-54285</cve>
  </suppress>
</suppressions>
